# Generate a long random value and use the exact same value as FACE_SERVICE_SECRET
# in the Next.js root .env.local. Never commit the real secret.
FACE_SERVICE_SECRET=

# Optional runtime tuning. Defaults match the V1 implementation.
SFACE_COSINE_THRESHOLD=0.363
FACE_DETECTION_THRESHOLD=0.85
FACE_NMS_THRESHOLD=0.3
FACE_MAX_IMAGE_BYTES=2097152
FACE_MIN_FACE_PIXELS=80
FACE_MIN_BLUR_VARIANCE=80
FACE_MIN_BRIGHTNESS=40
FACE_MAX_BRIGHTNESS=220

# Model directory relative to services/face-service.
FACE_MODEL_DIR=models
