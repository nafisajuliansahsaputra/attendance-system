# Attendance System uses its own dedicated Supabase project.
# Never copy credentials from Spall Spill or any unrelated application.

# Server-side project URL.
SUPABASE_URL=

# Browser-safe values for Supabase Auth/client features.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Never prefix this with NEXT_PUBLIC_ and never commit a real value.
# Prefer a modern sb_secret_ key over the legacy service_role key.
SUPABASE_SECRET_KEY=

# Provisioning-only identifier used by `npm run device:rotate-secret:env`.
# The generated plaintext device secret is printed once and belongs on the
# physical device/bridge; do not save that secret in this repository.
DEVICE_ID=

# Private local/server biometric inference service. FACE_SERVICE_SECRET is a
# server-to-server credential and must never use NEXT_PUBLIC_.
FACE_SERVICE_URL=http://localhost:8000
FACE_SERVICE_SECRET=

# Explicit institution timezone; do not rely on server-local timezone.
INSTITUTION_TIMEZONE=Asia/Jakarta
