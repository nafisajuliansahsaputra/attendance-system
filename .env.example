# Attendance System uses its own dedicated Supabase project.
# Never copy credentials from Spall Spill or any unrelated application.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Future biometric service boundary
FACE_SERVICE_URL=http://localhost:8000

# Explicit institution timezone; do not rely on server-local timezone.
INSTITUTION_TIMEZONE=Asia/Jakarta
