# Attendance System uses its own dedicated Supabase project.
# Never copy credentials from Spall Spill or any unrelated application.

# Server-side project URL.
SUPABASE_URL=

# Browser-safe values for Supabase Auth/client features when introduced.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Never prefix this with NEXT_PUBLIC_ and never commit a real value.
# Prefer a modern sb_secret_ key over the legacy service_role key.
SUPABASE_SECRET_KEY=

# Future biometric service boundary
FACE_SERVICE_URL=http://localhost:8000

# Explicit institution timezone; do not rely on server-local timezone.
INSTITUTION_TIMEZONE=Asia/Jakarta
